{
  "name": "reunion-national-administration-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:import": "node --experimental-strip-types scripts/import.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "backup": "node --experimental-strip-types scripts/backup.ts",
    "restore": "node --experimental-strip-types scripts/restore.ts",
    "check:sources": "node scripts/verify-sources.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "^133.0.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
